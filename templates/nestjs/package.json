{
  "name": "@specwarden/template-nestjs",
  "version": "0.1.0",
  "type": "module",
  "description": "template: A NestJS backend — module conventions via the plugin, credential scan, env pairing, migration guard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specwarden/specwarden.git",
    "directory": "templates/nestjs"
  },
  "homepage": "https://github.com/specwarden/specwarden/tree/main/templates/nestjs#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "specwarden": "workspace:^",
    "@specwarden/scaffold-parts": "workspace:^",
    "@specwarden/plugin-nestjs": "workspace:^",
    "@specwarden/security": "workspace:^",
    "@specwarden/ops": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
