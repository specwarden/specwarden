{
  "name": "@specwarden/scaffold-parts",
  "version": "0.2.0",
  "type": "module",
  "description": "scaffold: The pieces every template is assembled from.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specwarden/specwarden.git",
    "directory": "templates/_parts"
  },
  "homepage": "https://github.com/specwarden/specwarden/tree/main/templates/_parts#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "specwarden": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "@specwarden/agents": "workspace:*",
    "@specwarden/docs": "workspace:*",
    "@specwarden/ops": "workspace:*",
    "@specwarden/openspec": "workspace:*",
    "@specwarden/plans": "workspace:*",
    "@specwarden/security": "workspace:*",
    "@specwarden/speckit": "workspace:*"
  }
}
