{
  "name": "specwarden",
  "version": "0.0.0",
  "type": "module",
  "description": "core: A repository declares its rules; the warden proves which hold.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specwarden/specwarden.git",
    "directory": "core"
  },
  "homepage": "https://github.com/specwarden/specwarden/tree/main/core#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "specwarden": "./bin/warden.mjs",
    "spw": "./bin/warden.mjs"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "bin",
    "scripts",
    "skills"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build",
    "test:watch": "vitest",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1"
  }
}
