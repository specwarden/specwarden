# The engine is published unscoped and its packages under no organisation scope, so
# nothing here needs a registry or an auth line. What is set is the one thing a
# publishing repository must not leave to chance.

# A tarball is assembled from `files`; a package whose build did not run would publish an
# empty one silently. `prepare` builds on install, and this makes an install that skipped
# a lifecycle script a loud failure rather than a quiet one.
enable-pre-post-scripts=true

# esbuild ships a platform binary and needs its install script to place it. Approving it
# by name rather than globally: an unreviewed postinstall is arbitrary code from the
# dependency tree, and "allow all" is how that stops being a decision.
onlyBuiltDependencies[]=esbuild
